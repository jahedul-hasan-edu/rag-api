# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Database (Supabase PostgreSQL connection string)
# Format: postgresql+asyncpg://user:password@host:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# OpenAI (grounded answers)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
LLM_TEMPERATURE=0

# Upload / ingestion
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
# Set false in lightweight test environments that mock embeddings
LOAD_EMBEDDING_MODEL_ON_STARTUP=true

# Retrieval / chat
RETRIEVAL_TOP_K=5
CONVERSATION_HISTORY_LIMIT=10
